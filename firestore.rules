rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /planesEntrenamiento/{id} {
      allow read, write: if true;
    }
    match /planesNutricion/{id} {
      allow read, write: if true;
    }
    match /fichasEdad/{id} {
      allow read, write: if true;
    }
    match /alimentosCalculadora/{id} {
      allow read, write: if true;
    }
    // Un doc por cédula; se sobrescribe cada día (sin historial).
    match /diarioCalorico/{cedula} {
      allow read, write: if true;
    }
    // Login privilegiado + panel Admin → Seguridad
    match /credenciales/{cedula} {
      allow read, write: if true;
    }
    match /config/{doc} {
      allow read, write: if true;
    }
    match /usuarios/{cedula} {
      allow read, write: if true;
    }
  }
}
